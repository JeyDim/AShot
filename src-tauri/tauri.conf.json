{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AdvantShoter",
  "mainBinaryName": "AdvantShoter",
  "identifier": "one.advant.shoter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Advant",
    "copyright": "© Advant",
    "category": "Utility",
    "shortDescription": "Скриншоты с редактором и ссылками advant.one",
    "longDescription": "AdvantShoter — снимки экрана из трея: выделение области, окна или элемента, рисование поверх снимка, история последних снимков и публикация в Box.com со ссылками на advant.one.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "ru-RU"
      }
    }
  }
}
