# Rust
/target/
**/target/

# Node / Vite
node_modules/
/dist/
*.local

# Tauri generated
/src-tauri/gen/schemas/

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Test artefacts
/test-results/
/playwright-report/
/docs/screenshots/.tmp/

# `tauri icon` also writes mobile icons; the app is Windows-only
src-tauri/icons/android/
src-tauri/icons/ios/
# AShot Dev (pull request builds) needs only the Windows icons
/src-tauri/icons-dev/*
!/src-tauri/icons-dev/32x32.png
!/src-tauri/icons-dev/128x128.png
!/src-tauri/icons-dev/128x128@2x.png
!/src-tauri/icons-dev/icon.ico
